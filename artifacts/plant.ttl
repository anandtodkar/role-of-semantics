qk:ElectricCurrent a qudt:QuantityKind ;
    qudt:hasDimensionVector "I^1" .

qk:Frequency a qudt:QuantityKind ;
    qudt:hasDimensionVector "T^-1" .

qk:MassFlowRate a qudt:QuantityKind ;
    qudt:hasDimensionVector "M^1.T^-1" .

qk:Voltage a qudt:QuantityKind ;
    qudt:hasDimensionVector "L^2.M^1.T^-3.I^-1" .

sio:CIPSkid a owl:Class ;
    rdfs:subClassOf sio:ProcessUnit .

sio:Chiller a owl:Class ;
    rdfs:subClassOf sio:UtilityEquipment ;
    owl:equivalentClass brick:Chiller .

sio:Compressor a owl:Class ;
    rdfs:subClassOf sio:UtilityEquipment ;
    owl:equivalentClass brick:Compressor .

sio:Enterprise a owl:Class ;
    rdfs:subClassOf sio:PhysicalAsset .

sio:Site a owl:Class ;
    rdfs:subClassOf sio:PhysicalAsset ;
    owl:equivalentClass brick:Site .

sio:isFedBy a owl:ObjectProperty ;
    rdfs:domain sio:PhysicalAsset ;
    rdfs:range sio:PhysicalAsset .

sio:isPartOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:domain sio:PhysicalAsset ;
    rdfs:range sio:PhysicalAsset .

plant:ENT a sio:Enterprise ;
    rdfs:label "Global Beverages AG"@en ;
    skos:notation "ENT" ;
    sio:criticality "medium" ;
    sio:hasPart plant:SITE-KA ;
    sio:isa95Level "Enterprise" ;
    sio:location "DE" .

<https://w3id.org/semindus/plant/interlock/ILK-01> a sio:Interlock ;
    rdfs:comment "Product valve may only open when accumulated pasteurisation units >= 15 PU."@en ;
    sio:guardOperator ">=" ;
    sio:guardSignal <https://w3id.org/semindus/plant/signal/L1_PAS_PU0103_PV> ;
    sio:guardValue 1.5e+01 .

<https://w3id.org/semindus/plant/interlock/ILK-02> a sio:Interlock ;
    rdfs:comment "Fill volume setpoint may only be changed while the filler is Idle, Held or Stopped."@en ;
    sio:guardOperator "state_in" ;
    sio:guardSignal <https://w3id.org/semindus/plant/signal/L1_FIL_UNIT_STATE> ;
    sio:guardValue "Held",
        "Idle",
        "Stopped" .

<https://w3id.org/semindus/plant/interlock/ILK-03> a sio:Interlock ;
    rdfs:comment "Pasteuriser temperature setpoint is locked while a CIP cycle is executing."@en ;
    sio:guardOperator "state_not_in" ;
    sio:guardSignal <https://w3id.org/semindus/plant/signal/L1_CIP_UNIT_STATE> ;
    sio:guardValue "Execute" .

<https://w3id.org/semindus/plant/interlock/ILK-04> a sio:Interlock ;
    rdfs:comment "Product valve may only open when accumulated pasteurisation units >= 15 PU."@en ;
    sio:guardOperator ">=" ;
    sio:guardSignal <https://w3id.org/semindus/plant/signal/L2_PAS_PU0103_PV> ;
    sio:guardValue 1.5e+01 .

