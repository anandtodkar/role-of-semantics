@prefix aas: <https://admin-shell.io/aas/3/0/> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eclass: <https://api.eclass-cdp.com/0173-1%2301-> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix plant: <https://w3id.org/semindus/plant/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qk: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sio: <https://w3id.org/semindus/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qk:Density a qudt:QuantityKind ;
    qudt:hasDimensionVector "L^-3.M^1" .

qk:Energy a qudt:QuantityKind ;
    qudt:hasDimensionVector "L^2.M^1.T^-2" .

qk:Force a qudt:QuantityKind ;
    qudt:hasDimensionVector "L^1.M^1.T^-2" .

unit:A a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:ElectricCurrent ;
    qudt:symbol "A" ;
    sio:dimensionVector "I^1" .

unit:CentiM3 a qudt:Unit ;
    qudt:conversionMultiplier 1e-06 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Volume ;
    qudt:symbol "cm3" ;
    sio:dimensionVector "L^3" .

unit:GM a qudt:Unit ;
    qudt:conversionMultiplier 1e-03 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Mass ;
    qudt:symbol "g" ;
    sio:dimensionVector "M^1" .

unit:HR a qudt:Unit ;
    qudt:conversionMultiplier 3.6e+03 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Time ;
    qudt:symbol "h" ;
    sio:dimensionVector "T^1" .

unit:HZ a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Frequency ;
    qudt:symbol "Hz" ;
    sio:dimensionVector "T^-1" .

unit:K a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Temperature ;
    qudt:symbol "K" ;
    sio:dimensionVector "Theta^1" .

unit:KiloGM a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Mass ;
    qudt:symbol "kg" ;
    sio:dimensionVector "M^1" .

unit:KiloGM-PER-HR a qudt:Unit ;
    qudt:conversionMultiplier 2.777778e-04 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:MassFlowRate ;
    qudt:symbol "kg/h" ;
    sio:dimensionVector "M^1.T^-1" .

unit:KiloPA a qudt:Unit ;
    qudt:conversionMultiplier 1e+03 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Pressure ;
    qudt:symbol "kPa" ;
    sio:dimensionVector "L^-1.M^1.T^-2" .

unit:L a qudt:Unit ;
    qudt:conversionMultiplier 1e-03 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Volume ;
    qudt:symbol "L" ;
    sio:dimensionVector "L^3" .

unit:L-PER-SEC a qudt:Unit ;
    qudt:conversionMultiplier 1e-03 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:VolumeFlowRate ;
    qudt:symbol "L/s" ;
    sio:dimensionVector "L^3.T^-1" .

unit:M a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Length ;
    qudt:symbol "m" ;
    sio:dimensionVector "L^1" .

unit:M3 a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Volume ;
    qudt:symbol "m3" ;
    sio:dimensionVector "L^3" .

unit:MIN a qudt:Unit ;
    qudt:conversionMultiplier 6e+01 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Time ;
    qudt:symbol "min" ;
    sio:dimensionVector "T^1" .

unit:MegaPA a qudt:Unit ;
    qudt:conversionMultiplier 1e+06 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Pressure ;
    qudt:symbol "MPa" ;
    sio:dimensionVector "L^-1.M^1.T^-2" .

unit:MilliBAR a qudt:Unit ;
    qudt:conversionMultiplier 1e+02 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Pressure ;
    qudt:symbol "mbar" ;
    sio:dimensionVector "L^-1.M^1.T^-2" .

unit:PA a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Pressure ;
    qudt:symbol "Pa" ;
    sio:dimensionVector "L^-1.M^1.T^-2" .

unit:SEC a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Time ;
    qudt:symbol "s" ;
    sio:dimensionVector "T^1" .

unit:V a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Voltage ;
    qudt:symbol "V" ;
    sio:dimensionVector "L^2.M^1.T^-3.I^-1" .

unit:W a qudt:Unit ;
    qudt:conversionMultiplier 1e+00 ;
    qudt:conversionOffset 0e+00 ;
    qudt:hasQuantityKind qk:Power ;
    qudt:symbol "W" ;
    sio:dimensionVector "L^2.M^1.T^-3" .

sio:accessMode a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

sio:alarmHigh a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

sio:alarmLow a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

sio:engineeringHigh a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

sio:engineeringLow a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

sio:feeds a owl:ObjectProperty ;
    rdfs:domain sio:PhysicalAsset ;
    rdfs:range sio:PhysicalAsset ;
    owl:inverseOf sio:isFedBy .

sio:guardSignal a owl:ObjectProperty ;
    rdfs:domain sio:Interlock ;
    rdfs:range sio:Signal .

sio:hasPart a owl:ObjectProperty ;
    rdfs:domain sio:PhysicalAsset ;
    rdfs:range sio:PhysicalAsset ;
    owl:inverseOf sio:isPartOf .

sio:hasSignal a owl:ObjectProperty ;
    rdfs:domain sio:PhysicalAsset ;
    rdfs:range sio:Signal ;
    rdfs:subPropertyOf ssn:hasProperty .

sio:interlockedBy a owl:ObjectProperty ;
    rdfs:domain sio:Signal ;
    rdfs:range sio:Interlock .

sio:isa95Level a owl:DatatypeProperty ;
    rdfs:domain sio:PhysicalAsset .

sio:opcuaNodeId a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

sio:packMLState a owl:DatatypeProperty ;
    rdfs:domain sio:PhysicalAsset .

sio:providesService a owl:DatatypeProperty ;
    rdfs:domain sio:PhysicalAsset .

sio:safetyCritical a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

sio:signalRole a owl:DatatypeProperty ;
    rdfs:domain sio:Signal .

<https://w3id.org/semindus/plant/event/EV-1001> a prov:Activity,
        sio:Alarm ;
    rdfs:comment "Bowl level low-low, filler held"@en ;
