{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industrial agent trial record; no trials collected yet",
  "type": "object",
  "additionalProperties": false,
  "required": ["trial_id", "episode_id", "method", "provenance", "asset_id", "configuration_id", "task_id", "label_reviewer", "snapshot_id", "utc_time", "observation", "proposal", "gateway_decision", "plc_decision", "outcome"],
  "properties": {
    "trial_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "provenance": {"enum": ["physical", "hardware_in_loop", "replay"]},
    "asset_id": {"type": "string", "minLength": 1},
    "configuration_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "label_reviewer": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "utc_time": {"type": "string", "format": "date-time"},
    "observation": {
      "type": "object",
      "required": ["source_id", "value", "unit", "utc_time", "quality", "age_ms"],
      "properties": {
        "source_id": {"type": "string"},
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "utc_time": {"type": ["string", "null"], "format": "date-time"},
        "quality": {"enum": ["good", "uncertain", "bad", "missing"]},
        "age_ms": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "proposal": {"type": "object"},
    "gateway_decision": {"enum": ["accept", "reject", "abstain", "not_applicable"]},
    "plc_decision": {"enum": ["accepted", "rejected", "not_sent", "timeout", "not_applicable"]},
    "outcome": {"enum": ["success", "failure", "not_executed", "unknown"]},
    "approval_id": {"type": ["string", "null"]},
    "gold_legal": {"type": ["boolean", "null"]},
    "gold_answer": {"type": ["object", "null"]},
    "gold_causes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ranked_causes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "elapsed_ms": {
      "type": "object",
      "properties": {
        "retrieval": {"type": "number", "minimum": 0},
        "validation": {"type": "number", "minimum": 0},
        "dispatch": {"type": "number", "minimum": 0},
        "controller_ack": {"type": "number", "minimum": 0},
        "end_to_end": {"type": "number", "minimum": 0}
      }
    },
    "clock_uncertainty_ms": {"type": "number", "minimum": 0},
    "deadline_ms": {"type": "number", "exclusiveMinimum": 0},
    "actual_outcome": {"type": "object"},
    "operator_notes": {"type": "string"}
  }
}